# Neon — pulled automatically by `neon link` / `neon env`
# Project: AtoEnglish (weathered-haze-10487148), branch: production
DATABASE_URL=postgres://<user>:<password>@<host-pooled>.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://<auth-host>.neon.tech
NEON_AUTH_JWKS_URL=https://<auth-host>.neon.tech/jwks.json
NEON_DATA_API_URL=https://<data-api-host>.neon.tech

# Neon Auth — session cookie signing secret (min 32 chars, generate once per env)
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=

# Public Data API URL for the browser client (same value as NEON_DATA_API_URL)
NEXT_PUBLIC_NEON_DATA_API_URL=https://<data-api-host>.neon.tech

# Canonical site origin for metadata/sitemap/robots/JSON-LD
# Production: https://<your-workers-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — Rate Limiting (Production)
# Đăng ký tại https://upstash.com (free tier: 10k requests/day)
# Dashboard > Create Database > REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Khi KHÔNG có Upstash (local dev), rate limiting dùng in-memory fallback tự động

# Sentry — Error Monitoring (Production)
# Đăng ký tại https://sentry.io (free tier: 5k errors/month)
# Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=atoenglish
SENTRY_AUTH_TOKEN=your-auth-token

# Web Push Notifications — VAPID Keys
# Tạo key pair bằng lệnh: npx web-push generate-vapid-keys
# Public key dùng ở client (NEXT_PUBLIC_*), Private key chỉ dùng ở server
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com
