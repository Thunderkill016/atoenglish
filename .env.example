# Neon — pulled automatically by `neon link` / `neon env`
# Project: AtoEnglish (weathered-haze-10487148), branch: production
DATABASE_URL=postgres://<user>:<password>@<host-pooled>.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://<auth-host>.neon.tech
NEON_AUTH_JWKS_URL=https://<auth-host>.neon.tech/jwks.json
NEON_DATA_API_URL=https://<data-api-host>.neon.tech

# Neon Auth — session cookie signing secret (min 32 chars, generate once per env)
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=

# Public Data API URL for the browser client (same value as NEON_DATA_API_URL)
NEXT_PUBLIC_NEON_DATA_API_URL=https://<data-api-host>.neon.tech

# Canonical site origin for metadata/sitemap/robots/JSON-LD
# Production: https://<your-workers-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — Rate Limiting (Production)
# Đăng ký tại https://upstash.com (free tier: 10k requests/day)
# Dashboard > Create Database > REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Khi KHÔNG có Upstash (local dev), rate limiting dùng in-memory fallback tự động

# Google Gemini — optional AI feedback for writing/speaking/translation.
# Không có key: writing trả lỗi "chưa cấu hình" (không giả điểm), speaking dùng
# phân tích heuristic local, các tính năng khác degrade tương đương.
GEMINI_API_KEY=
# Optional subtitle AI: enable only after verifying the project billing tier/quota.
# Default false prevents subtitle requests from using this key automatically.
SUBTITLE_GEMINI_ENABLED=false
# Optional: route Gemini through Cloudflare AI Gateway (logs/cache/rate limit).
# Unset = direct generativelanguage.googleapis.com calls.
CF_AI_GATEWAY_BASE=

# Cross-platform subtitle translation via the Worker `AI` binding (Gemma 4 26B
# on Workers AI). No key: works only inside the deployed Worker; Node dev has
# no binding and reports "not enabled". Billed per Neurons past the free tier.
SUBTITLE_WORKERS_AI_ENABLED=false

# Experimental self-hosted Hy-MT2, explicitly enabled only after model/quality checks.
# Uses the same signed-in translation boundary; no Gemini fallback on local failures.
SUBTITLE_LOCAL_ENABLED=false
SUBTITLE_LOCAL_URL=http://127.0.0.1:8089/v1/chat/completions
SUBTITLE_LOCAL_KEY=
# Expected deployment: official Tencent Hy-MT2-1.8B Q4_K_M at
# a0c709d9fac510f2c807aa3af52872340dc37a4a, llama.cpp b11457, alias hymt2-1.8b-q4.
# Loopback works with the local Next server, not a deployed Cloudflare Worker.
