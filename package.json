{
  "name": "atoenglish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit": "node scripts/audit-code.mjs",
    "inventory": "node scripts/inventory-codebase.mjs",
    "check:source-of-truth": "node scripts/check-source-of-truth.mjs",
    "check:source-of-truth:self-test": "node scripts/check-source-of-truth.mjs --self-test",
    "verify": "node scripts/verify-change.mjs",
    "verify:fast": "node scripts/verify-change.mjs --fast",
    "verify:plan": "node scripts/verify-change.mjs --plan",
    "test": "vitest run --exclude src/__tests__/lesson-content-standard.test.ts",
    "test:content-standard": "vitest run src/__tests__/lesson-content-standard.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "dotenv -e .env.local -- playwright test",
    "e2e:a11y": "dotenv -e .env.local -- playwright test e2e/accessibility-smoke.spec.ts",
    "e2e:time-to-lesson": "dotenv -e .env.local -- playwright test e2e/time-to-lesson.spec.ts",
    "e2e:ui": "dotenv -e .env.local -- playwright test --ui",
    "db:migrate": "node scripts/neon/adapt-migrations.mjs && dotenv -e .env.local -- node scripts/neon/replay-migrations.mjs --bootstrap",
    "db:lint": "npx --yes squawk-cli@1.5.0 --pg-version 18 supabase/migrations",
    "db:test": "dotenv -e .env.local -- bash scripts/db-test.sh",
    "db:types": "dotenv -e .env.local -- bash scripts/db-types.sh",
    "prepare": "husky",
    "test:integration": "dotenv -e .env.local -- vitest run --config vitest.integration.config.ts",
    "audio:generate": "tsx scripts/generate-unit-audio.ts",
    "audio:generate:a0": "tsx scripts/generate-unit-audio.ts unit-a0-1 && tsx scripts/generate-unit-audio.ts unit-a0-2 && tsx scripts/generate-unit-audio.ts unit-a0-3 && tsx scripts/generate-unit-audio.ts unit-a0-4 && tsx scripts/generate-unit-audio.ts unit-a0-5 && tsx scripts/generate-unit-audio.ts unit-a0-6 && tsx scripts/generate-unit-audio.ts unit-a0-7 && tsx scripts/generate-unit-audio.ts unit-a0-8",
    "audio:generate:a1": "for u in unit-1 unit-2 unit-3 unit-4 unit-5 unit-6 unit-7 unit-8 unit-9 unit-10 unit-11 unit-12; do tsx scripts/generate-unit-audio.ts $u; done",
    "audio:generate:a2": "for u in unit-13 unit-14 unit-15 unit-16 unit-17 unit-18; do tsx scripts/generate-unit-audio.ts $u; done",
    "audio:generate:b1": "for u in unit-19 unit-20 unit-21 unit-22 unit-23 unit-24 unit-25 unit-26 unit-27 unit-28 unit-29 unit-30 unit-31 unit-32; do tsx scripts/generate-unit-audio.ts $u; done",
    "audio:generate:b2": "for u in unit-33 unit-34 unit-35 unit-36 unit-37 unit-38 unit-39 unit-40 unit-41 unit-42; do tsx scripts/generate-unit-audio.ts $u; done",
    "audio:generate:all": "npm run audio:generate:a0 && npm run audio:generate:a1 && npm run audio:generate:a2 && npm run audio:generate:b1 && npm run audio:generate:b2",
    "audio:generate:list": "tsx scripts/generate-unit-audio.ts list",
    "check-deploy": "bash scripts/check-cf-deploy.sh",
    "check-deploy:wait": "sleep 30 && bash scripts/check-cf-deploy.sh",
    "smoke:learn": "bash scripts/smoke-learn.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^10.59.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^26",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^4.1.9",
    "cf": "^1.0.0-beta.12",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8",
    "react-server-dom-webpack": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vinext": "^1.0.1",
    "vite": "^8.3.2",
    "vite-css-modules": "^1.16.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10",
    "wrangler": "^4.147.0"
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Safari >= 16.4",
      "Firefox >= 128",
      "Edge >= 111",
      "iOS >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Safari version",
      "last 1 Firefox version"
    ]
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "type": "module"
}
