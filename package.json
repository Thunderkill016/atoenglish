{
  "name": "atoenglish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "inventory": "node scripts/inventory-codebase.mjs",
    "check:source-of-truth": "node scripts/check-source-of-truth.mjs",
    "check:source-of-truth:self-test": "node scripts/check-source-of-truth.mjs --self-test",
    "verify": "node scripts/verify-change.mjs",
    "verify:fast": "node scripts/verify-change.mjs --fast",
    "verify:plan": "node scripts/verify-change.mjs --plan",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "dotenv -e .env.local -- playwright test",
    "e2e:ui": "dotenv -e .env.local -- playwright test --ui",
    "db:migrate": "node scripts/neon/adapt-migrations.mjs && dotenv -e .env.local -- node scripts/neon/replay-migrations.mjs --bootstrap",
    "db:lint": "npx --yes squawk-cli@1.5.0 --pg-version 18 supabase/migrations",
    "db:test": "dotenv -e .env.local -- bash scripts/db-test.sh",
    "db:types": "dotenv -e .env.local -- bash scripts/db-types.sh",
    "prepare": "husky",
    "test:integration": "dotenv -e .env.local -- vitest run --config vitest.integration.config.ts",
    "check-deploy": "bash scripts/check-cf-deploy.sh",
    "check-deploy:wait": "sleep 30 && bash scripts/check-cf-deploy.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/deploy-cf.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neon/config": "^1.8.3",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^26",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^4.1.9",
    "cf": "^1.0.0-beta.12",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8",
    "react-server-dom-webpack": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vinext": "^1.0.1",
    "vite": "^8.3.2",
    "vite-css-modules": "^1.16.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.147.0"
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Safari >= 16.4",
      "Firefox >= 128",
      "Edge >= 111",
      "iOS >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Safari version",
      "last 1 Firefox version"
    ]
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "type": "module"
}
